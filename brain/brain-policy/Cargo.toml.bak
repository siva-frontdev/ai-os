[package]
name = "brain-policy"
version = "0.1.0"
edition = "2024"
license = "MIT"
description = "Brain Platform — policy engine, guard rails, rule compilation (isolated crate)"

[dependencies]
brain-core = { path = "../brain-core" }
ai-os-core = { path = "../../core" }
tokio = { version = "1", features = ["sync"] }
thiserror = "2"
async-trait = "0.1"
uuid = { version = "1", features = ["v4", "v7", "serde"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
chrono = { version = "0.4", features = ["serde"] }

[dev-dependencies]
tokio = { version = "1", features = ["rt", "macros"] }
